<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/style.css">
    <title>NeuroNest</title>
</head>

<body>
    <nav id="menu">
        <div class="menu-left">
            <img id="logo" src="../img/logo.jpeg" alt="logo">
            <h2>NeuroNest</h2>
        </div>
        <div id="menu-right">
            <ul>
                <li style="padding-top:12px;">
                    <img id="dark" class="menu-img" src="../img/moon.svg" alt="dark">
                    <img id="light" class="menu-img" src="../img/sun.svg" alt="light">
                </li>
                <li><a href="/">Home</a></li>
                <!-- <li><a href="#Contact">Contact us</a></li> -->
                <li><a href="#About">About us</a></li>
                <li><a href="/Ai">AI</a></li>
                <li><button class="btn ">
                    <%= User %>
                </button></li>
            </ul>
            
        </div>
        <div id="hamburger">
                <img id="menu-logo" src="../img/menu.svg" alt="">
                <img id="cross-logo" src="../img/cross.svg" alt="">
            </div>
    </nav>
    <!-- Introduction -->
    <section id="Introduction">
        <h1 class="parent-padding">Unlock Skills via AI</h1>
        <h3 class="parent-padding" >Master skills fast through personalized paths and progress
            <br>insights--quiz smart,excel now!
        </h3>
        <button class="btn parent-padding" href="/auth">Join NeuroNest Now!</button>
    </section>

    <!-- Key Feature -->

    <section id="key-feature">
        <h1 class="content-heading">Key Feature</h1>
        <div class="keyfeature-cards">
            <div class="card">
                <img src="../img/adaptiveQuiz.avif" alt="">
                <h3>Adaptive Quizzes</h3>
                <h4>Tailored challenges that adjust to
                    your level for faster skill mastery
                </h4>
            </div>

            <div class="card">
                <img src="../img/instant.png" alt="">
                <h3>Instant Feedback</h3>
                <h4>
                    AI-powered insight help you learn
                    from every answer immediately
                </h4>
            </div>

            <div class="card">
                <img src="../img/arrow.png" alt="">
                <h3>Track your Progress</h3>
                <h4>
                    Personalized paths and analytics
                    to see real growth over time
                </h4>
            </div>

        </div>
    </section>
    <!-- About us -->
    <section id="About">
        <div class="About-right">
            <h1 class="content-heading">About us</h1><br>
            <h2><u>NeuroNest</u></h2>
            <h3>NeuroNest is an innovative AI-powered quiz platform designed to transform the way students learn. Built
                with a passion for smarter, more effective education, NeuroNest leverages adaptive technology to create
                personalized learning experiences for students around the world.

                At NeuroNest, we believe that learning should not be passive — it should be interactive, dynamic, and
                tailored to each learner’s needs. Our intelligent system analyzes user performance in real time,
                identifying strengths, weaknesses, and learning patterns. Based on this data, it automatically adjusts
                question difficulty, recommends targeted practice, and provides meaningful insights that help students
                improve faster.</h3>
        </div>

        <div class="About-left">
            <img src="../img/logo.jpeg" alt="logo">
            <h1>NeuroNest</h1>
        </div>
    </section>

    <footer id="foot">
        All copyright &copy; reserved by NeuroNest
    </footer>
    <script src="../js/script.js"></script>
</body>

</html>